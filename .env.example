# Copy to .env for local development. Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# On Wodby the service sets all of these; .env is not used there.

HOST=0.0.0.0
PORT=1337

APP_KEYS=tobemodified1,tobemodified2
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# PostgreSQL. DATABASE_URL takes precedence over the separate variables.
DATABASE_URL=postgresql://strapi:strapi@localhost:5432/strapi
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
# DATABASE_SSL=false

# Optional mail server. Without SMTP_HOST, Strapi's default email provider is used.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=no-reply@example.com

STRAPI_TELEMETRY_DISABLED=true
